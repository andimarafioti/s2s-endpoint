FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

LABEL org.opencontainers.image.source="https://github.com/andimarafioti/s2s-endpoint"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    GGML_BACKEND=CUDA0 \
    HF_HUB_DISABLE_TELEMETRY=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip libgomp1 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04 and the A10G host use CUDA 12.4. Pin the matching native wheel;
# the default PyPI Linux wheel is built for CUDA 12.8.
RUN python3 -m pip install --no-cache-dir \
    'numpy>=1.26,<3' 'fastapi>=0.100,<1' 'uvicorn>=0.24,<1' \
    'huggingface-hub>=1.5,<2' && \
    python3 -m pip install --no-cache-dir \
    'https://huggingface.co/datasets/andito/qwentts-cpp-python-wheels/resolve/main/whl/cu124/qwentts_cpp_python-0.4.1%2Bcu124-py3-none-manylinux_2_35_x86_64.whl'

# Bake the exact GGUF weights used for the local quality comparison into this
# canary image. The HF endpoint model mount remains independent of inference.
RUN mkdir -p /opt/models && python3 -c 'from huggingface_hub import hf_hub_download; import shutil; from pathlib import Path; repo="Serveurperso/Qwen3-TTS-GGUF"; rev="b7ee2e8c7459c3bea99da23e3d178125a7d1713c"; target=Path("/opt/models"); files=("qwen-talker-1.7b-customvoice-Q4_K_M.gguf", "qwen-tokenizer-12hz-Q8_0.gguf"); [shutil.copyfile(hf_hub_download(repo_id=repo, filename=name, revision=rev), target/name) for name in files]' && \
    rm -rf /root/.cache/huggingface

WORKDIR /opt/service
COPY app/ggml_tts_app.py /opt/service/ggml_tts_app.py
EXPOSE 8091
CMD ["uvicorn", "ggml_tts_app:app", "--host", "0.0.0.0", "--port", "8091", "--workers", "1"]
