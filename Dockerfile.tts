ARG VLLM_OMNI_VERSION=0.24.0
FROM vllm/vllm-omni:v${VLLM_OMNI_VERSION}

EXPOSE 8091

# The bundled deploy config enables async chunking and keeps multi-request
# batching. The model itself is mounted by Inference Endpoints at /repository.
ENTRYPOINT []
CMD ["vllm", "serve", "/repository", "--served-model-name", "Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice", "--deploy-config", "/app/vllm-omni/vllm_omni/deploy/qwen3_tts.yaml", "--omni", "--host", "0.0.0.0", "--port", "8091", "--trust-remote-code"]
