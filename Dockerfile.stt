ARG VLLM_VERSION=0.24.0
FROM vllm/vllm-openai:v${VLLM_VERSION}

ARG VLLM_VERSION

# The official vLLM image intentionally omits optional audio dependencies.
# Keep the extra version aligned with the preinstalled vLLM package.
RUN uv pip install --system --no-cache-dir "vllm[audio]==${VLLM_VERSION}"

EXPOSE 8000

ENTRYPOINT ["vllm", "serve"]
CMD ["/repository", "--served-model-name", "Qwen/Qwen3-ASR-1.7B", "--host", "0.0.0.0", "--port", "8000"]
