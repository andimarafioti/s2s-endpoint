+    def _language_for_input(self, language_code: str | None) -> str | None:
+        # A named language deliberately pins synthesis. Auto follows the STT language
+        # carried through LLM chunks; unknown/missing codes remain Auto for Qwen.
+        if not self.language or self.language.casefold() != "auto":
+            return self.language
+        if not self.model.lower().startswith("qwen/qwen3-tts") or not language_code:
+            return self.language
+        code = language_code.strip().casefold()
+        if code.endswith("-auto"):
+            code = code[:-5]
+        code = code.replace("_", "-").split("-", 1)[0]
+        if code in _QWEN_LANGUAGE_BY_CODE:
+            return _QWEN_LANGUAGE_BY_CODE[code]
+        for language in _QWEN_LANGUAGE_BY_CODE.values():
+            if code == language.casefold():
+                return language
+        return self.language
